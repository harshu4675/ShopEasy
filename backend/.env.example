# ─────────────────────────────────────────────────────────────
# ShopEasy (Talish Clothes) — backend environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Core
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/shopeasy

# Auth
JWT_SECRET=change-me
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRE=7d
JWT_REMEMBER_EXPIRE=30d

# CORS / frontend
CLIENT_URL=http://localhost:5173
FRONTEND_URL=https://talishclothes.netlify.app
BACKEND_URL=http://localhost:5000
WEBSITE_URL=https://talishclothes.netlify.app

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Talish Clothes
ADMIN_EMAIL=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@talish.com

# ─────────────────────────────────────────────────────────────
# Affiliate product import
# ─────────────────────────────────────────────────────────────
# OPTIONAL — the importer works with no marketplace credentials at all. It
# reads publicly visible page metadata (JSON-LD, OpenGraph, meta tags) for
# Amazon, Flipkart, Myntra, Ajio, Meesho and any other product page.
#
# The keys below only upgrade the Amazon import to the official Product
# Advertising API when present. Leave them empty to keep using public metadata.

AMAZON_API_KEY=
AMAZON_API_SECRET=
AMAZON_PA_API_KEY=
AMAZON_PA_API_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_PARTNER_TAG=

# Optional Flipkart Affiliate API (official product feed), for future use.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
