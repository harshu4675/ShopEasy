# Frontend environment variables.
#
# Copy to `.env` for local development. Only variables prefixed with VITE_ are
# exposed to the client bundle, and they are INLINED AT BUILD TIME - setting
# them on the host after a build has no effect. On Netlify they must exist as
# build environment variables *before* the build runs, otherwise the fallback
# values compiled into api.js are used instead.

# Base URL of the backend API, including the trailing /api path segment.
# If unset, the app falls back to the hosted Render URL in src/utils/api.js.
# Local development against a local backend:
#   VITE_API_URL=http://localhost:5000/api
VITE_API_URL=https://shopeasy-ecommerce-app.onrender.com/api

# Public VAPID key for Web Push. Must match VAPID_PUBLIC_KEY on the backend.
# Leave empty to disable push notification subscriptions in the client.
VITE_VAPID_PUBLIC_KEY=
